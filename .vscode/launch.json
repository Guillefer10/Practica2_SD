{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Spring Boot Launch",
            "type": "java",
            "request": "launch",
            "mainClass": "com.example.practica2.Practica2Application",
            "projectName": "ui-web"
        },
        {
            "name": "Flask API",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python-api/app.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development"
            }
        }
    ]
}